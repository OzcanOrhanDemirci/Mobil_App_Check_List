# of the old monolithic 03-data.js in 1.1.0; the stub remains as a
# re-export and the actual content lives in the shards.
/js/01-i18n-strings.js                  @OzcanOrhanDemirci
/js/02-help-content.js                  @OzcanOrhanDemirci
/js/03-data.js                          @OzcanOrhanDemirci
/js/03[a-n]-data-*.js                   @OzcanOrhanDemirci

